{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alexia",
  "version": "0.1.0",
  "identifier": "dev.alexia.app",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "SignPath Foundation",
    "shortDescription": "An assistant that runs on your own machine.",
    "longDescription": "Alexia runs on your machine, routes work to whichever model suits it, and can be extended by dropping a folder in — or emptied by deleting one.",
    "externalBin": ["binaries/alexia-core"],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": ["https://alexia.dev/updates/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": ""
    }
  }
}
