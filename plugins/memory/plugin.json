{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "memory",
  "name": "Long-term memory",
  "summary": "Remembers things across conversations, and always knows the few you pin — your name, how to talk to you. Can also write things down by itself, once you turn that on.",
  "version": "0.8.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 12,
  "mcp_protocol": "2025-11-25",
  "requires": [
    {
      "cap": "text.embed",
      "why": "If something here can embed text, to find what you said by what it means, not only by its words."
    },
    {
      "cap": "contacts.find",
      "why": "If something here can look people up in your contacts, to fill in birthdays and how to reach them."
    },
    {
      "cap": "fs.own_dir",
      "why": "Somewhere of its own to keep the plain file that lists what Alexia always knows about you, if you ask for one."
    },
    {
      "cap": "fs.read_scoped",
      "why": "To read an export you point it at, and the profile file you chose, only inside folders you opened."
    },
    {
      "cap": "fs.write_scoped",
      "why": "To write the profile file you chose, only inside folders you opened. Nothing else is ever written there."
    }
  ],
  "provides": [
    "memory.remember",
    "memory.recall",
    "memory.capture",
    "memory.profile",
    "notice.items",
    "notice.done",
    "brief.section"
  ],
  "settings": [
    {
      "type": "number",
      "key": "recall_limit",
      "label": "How much to bring back",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 6,
      "hint": "How many remembered things a search returns at most. More helps her answer, and costs more."
    },
    {
      "type": "toggle",
      "key": "capture",
      "label": "Write things down by itself",
      "default": false,
      "hint": "Off, she only remembers what you tell her to. On, she turns finished conversations into notes on her own. Passwords and keys are removed first."
    },
    {
      "type": "number",
      "key": "interval",
      "label": "How often to sort through it",
      "min": 1,
      "max": 240,
      "step": 1,
      "default": 12,
      "hint": "Minutes between passes. When nothing is waiting, a pass costs nothing."
    },
    {
      "type": "number",
      "key": "every",
      "label": "Sort after this many messages",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 5,
      "hint": "Once this many exchanges are waiting, they are sorted straight away instead of waiting for the timer. The timer still catches the rest on a quiet day."
    },
    {
      "type": "text",
      "key": "skip",
      "label": "Also not worth writing down",
      "placeholder": "e.g. lol, brb, sure thing",
      "hint": "Comma-separated. Anything you say that is exactly one of these is never kept for sorting — on top of the built-in list (ok, continue, why, test, thanks…) and anything under three words."
    },
    {
      "type": "path",
      "key": "profile_file",
      "kind": "file",
      "label": "Profile file",
      "hint": "Leave it empty and there is no file. Choose one and what Alexia always knows about you is written there, one line each. Add a line and she remembers it; take one away and she stops always knowing it. It has to be in a folder you opened."
    },
    {
      "type": "status",
      "key": "state",
      "label": "State"
    },
    {
      "type": "action",
      "key": "sort_now",
      "label": "Sort through it now",
      "tool": "sort_now",
      "hint": "Do the next pass now instead of waiting for the timer. Does nothing if there is nothing waiting."
    },
    {
      "type": "action",
      "key": "forget_all",
      "label": "Forget everything",
      "tool": "forget_all",
      "confirm": "Press again to forget everything",
      "hint": "Empties long-term memory. The conversation you are having now is not touched — that belongs to Alexia, not to this plugin."
    }
  ],
  "storage": {
    "namespace": "memory",
    "tables": [
      "facts",
      "buffer",
      "forgotten",
      "branches",
      "people",
      "dates",
      "goals",
      "days"
    ]
  },
  "commands": [
    {
      "name": "remembered",
      "summary": "What Alexia remembers about you"
    }
  ],
  "panel": {
    "label": "Memory",
    "widgets": [
      {
        "key": "remembered_tree",
        "type": "tree",
        "label": "The shape of it",
        "hint": "Everything remembered, filed the way Alexia files it: you at the top, then a section for each part of your life, then the topics inside it. Open a section to see what is in it, and press a note to read the whole of it and to change it. A note filed in two places shows up in both and says where else it lives.",
        "rows": "memory_tree",
        "detail": "about_memory",
        "filter": true,
        "rowActions": [
          {
            "key": "note_pin",
            "label": "Always know this",
            "tool": "pin",
            "unless": {
              "tag": "always known"
            }
          },
          {
            "key": "note_unpin",
            "label": "Stop always knowing",
            "tool": "unpin",
            "when": {
              "tag": "always known"
            }
          },
          {
            "key": "note_lock",
            "label": "Lock",
            "tool": "lock",
            "unless": {
              "tag": "🔒 locked"
            }
          },
          {
            "key": "note_unlock",
            "label": "Unlock",
            "tool": "unlock",
            "when": {
              "tag": "🔒 locked"
            }
          },
          {
            "key": "note_accept_suggestion",
            "label": "Accept suggestion",
            "tool": "accept_suggestion",
            "when": {
              "tag": "suggestion"
            }
          },
          {
            "key": "note_still_true",
            "label": "Still true",
            "tool": "still_true",
            "when": {
              "tag": "may be out of date"
            }
          },
          {
            "key": "note_no_longer_true",
            "label": "No longer true",
            "tool": "no_longer_true",
            "unless": {
              "tag": "no longer true"
            }
          },
          {
            "key": "note_history",
            "label": "History",
            "tool": "history"
          },
          {
            "key": "note_forget",
            "label": "Forget",
            "tool": "forget_one",
            "confirm": "Forget it, and every earlier version of it?"
          }
        ]
      },
      {
        "key": "people",
        "type": "table",
        "label": "People",
        "hint": "Everyone Alexia knows from what you said: how you know them, their birthday, and when they last came up. Press a row to read what is written about them.",
        "rows": "people_rows",
        "detail": "about_person",
        "filter": true,
        "columns": [
          {
            "key": "name",
            "label": "Who"
          },
          {
            "key": "relation",
            "label": "How you know them"
          },
          {
            "key": "birthday",
            "label": "Birthday",
            "hideNarrow": true
          },
          {
            "key": "lastSeen",
            "label": "Last came up",
            "align": "right",
            "hideNarrow": true
          }
        ]
      },
      {
        "key": "goals",
        "type": "table",
        "label": "Goals",
        "hint": "What you said you are working towards. Mark one done and she stops asking after it.",
        "rows": "goal_rows",
        "filter": true,
        "columns": [
          {
            "key": "goal",
            "label": "Goal"
          },
          {
            "key": "since",
            "label": "Since",
            "hideNarrow": true
          },
          {
            "key": "lastTouched",
            "label": "Last touched",
            "align": "right",
            "hideNarrow": true
          },
          {
            "key": "state",
            "label": "State"
          }
        ],
        "rowActions": [
          {
            "key": "goal_done",
            "label": "Done",
            "tool": "goal_done",
            "when": {
              "field": "state",
              "is": "active"
            }
          }
        ]
      },
      {
        "key": "coming_up",
        "type": "table",
        "label": "Coming up",
        "hint": "Dated things you mentioned, in the next 30 days.",
        "rows": "date_rows",
        "columns": [
          {
            "key": "what",
            "label": "What"
          },
          {
            "key": "when",
            "label": "When"
          },
          {
            "key": "kind",
            "label": "Kind",
            "hideNarrow": true
          }
        ]
      },
      {
        "key": "your_days",
        "type": "table",
        "label": "Your days",
        "hint": "One short line for each of the last 60 days, newest first, written overnight from what was remembered. A fact you locked is never in it.",
        "rows": "day_rows",
        "columns": [
          {
            "key": "date",
            "label": "Day"
          },
          {
            "key": "text",
            "label": "What happened"
          }
        ]
      },
      {
        "key": "remembered_list",
        "type": "table",
        "label": "Remembered",
        "hint": "Everything Alexia has written down about you, whether you said it or she worked it out, and whether it is still true. What stopped being true is kept at the bottom as history; forgetting one takes every version of it.",
        "rows": "memories",
        "columns": [
          {
            "key": "text",
            "label": "What"
          },
          {
            "key": "from",
            "label": "How it got here"
          },
          {
            "key": "tags",
            "label": "State",
            "hideNarrow": true
          },
          {
            "key": "pinned",
            "label": "Always known",
            "hideNarrow": true
          },
          {
            "key": "when",
            "label": "Written down",
            "align": "right",
            "hideNarrow": true
          }
        ],
        "rowActions": [
          {
            "key": "still_true",
            "label": "Still true",
            "tool": "still_true",
            "when": {
              "tag": "may be out of date"
            }
          },
          {
            "key": "no_longer_true",
            "label": "No longer true",
            "tool": "no_longer_true",
            "unless": {
              "tag": "no longer true"
            }
          },
          {
            "key": "accept_suggestion",
            "label": "Accept suggestion",
            "tool": "accept_suggestion",
            "when": {
              "tag": "suggestion"
            }
          },
          {
            "key": "history",
            "label": "History",
            "tool": "history"
          },
          {
            "key": "pin",
            "label": "Always know this",
            "tool": "pin",
            "unless": {
              "field": "pinned",
              "is": "always known"
            }
          },
          {
            "key": "unpin",
            "label": "Stop always knowing",
            "tool": "unpin",
            "when": {
              "field": "pinned",
              "is": "always known"
            }
          },
          {
            "key": "lock",
            "label": "Lock",
            "tool": "lock",
            "unless": {
              "tag": "🔒 locked"
            }
          },
          {
            "key": "unlock",
            "label": "Unlock",
            "tool": "unlock",
            "when": {
              "tag": "🔒 locked"
            }
          },
          {
            "key": "forget_one",
            "label": "Forget",
            "tool": "forget_one",
            "confirm": "Forget it, and every earlier version of it?"
          }
        ],
        "detail": "about_memory",
        "filter": true,
        "groupBy": "kind",
        "chips": [
          {
            "key": "doubtful",
            "label": "May be out of date",
            "tags": [
              "may be out of date"
            ]
          },
          {
            "key": "suggested",
            "label": "Suggestions",
            "tags": [
              "suggestion"
            ]
          },
          {
            "key": "gone",
            "label": "No longer true",
            "tags": [
              "no longer true"
            ]
          }
        ]
      }
    ]
  },
  "page": {
    "title": "Memory",
    "sizes": {
      "M": {
        "at": [
          12,
          10
        ],
        "show": [
          "remembered_tree"
        ]
      },
      "L": {
        "at": [
          20,
          14
        ],
        "show": [
          "remembered_tree",
          "remembered_list"
        ]
      }
    },
    "fixed": false
  },
  "lifetime": "resident"
}
