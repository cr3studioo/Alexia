{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "memory",
  "name": "Long-term memory",
  "summary": "Remembers things across conversations, and always knows the few you pin — your name, how to talk to you. Can also write things down by itself, once you turn that on.",
  "version": "0.4.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 11,
  "mcp_protocol": "2025-11-25",
  "requires": [],
  "provides": [
    "memory.remember",
    "memory.recall",
    "memory.capture",
    "memory.profile"
  ],
  "settings": [
    {
      "type": "number",
      "key": "recall_limit",
      "label": "How much to bring back",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 6,
      "hint": "How many remembered things a search returns at most. More is more context and more cost."
    },
    {
      "type": "toggle",
      "key": "capture",
      "label": "Write things down by itself",
      "default": false,
      "hint": "Off, Alexia only remembers what it is told to. On, every finished exchange is kept briefly and turned into notes on a timer — nothing leaves this machine that would not have anyway, and credentials are stripped before it ever sees them."
    },
    {
      "type": "number",
      "key": "interval",
      "label": "How often to sort through it",
      "min": 1,
      "max": 240,
      "step": 1,
      "default": 12,
      "hint": "Minutes between passes. An empty buffer costs nothing — no model is called when there is nothing to sort."
    },
    {
      "type": "status",
      "key": "state",
      "label": "State"
    },
    {
      "type": "action",
      "key": "sort_now",
      "label": "Sort through it now",
      "tool": "sort_now",
      "hint": "Do the next pass now instead of waiting for the timer. Does nothing if there is nothing waiting."
    },
    {
      "type": "action",
      "key": "forget_all",
      "label": "Forget everything",
      "tool": "forget_all",
      "hint": "Empties long-term memory. The conversation you are having now is not touched — that belongs to Alexia, not to this plugin."
    }
  ],
  "storage": {
    "namespace": "memory",
    "tables": [
      "facts",
      "buffer",
      "forgotten",
      "branches"
    ]
  },
  "commands": [
    {
      "name": "remembered",
      "summary": "What Alexia remembers about you"
    }
  ],
  "panel": {
    "label": "Memory",
    "widgets": [
      {
        "key": "remembered_tree",
        "type": "tree",
        "label": "The shape of it",
        "hint": "Everything remembered, filed the way Alexia files it: you at the top, then a section for each part of your life, then the topics inside it. Open a section to see what is in it, and press a note to read the whole of it and to change it. A note filed in two places shows up in both and says where else it lives.",
        "rows": "memory_tree",
        "detail": "about_memory",
        "filter": true,
        "rowActions": [
          {
            "key": "note_pin",
            "label": "Always know this",
            "tool": "pin",
            "unless": {
              "tag": "always known"
            }
          },
          {
            "key": "note_unpin",
            "label": "Stop always knowing",
            "tool": "unpin",
            "when": {
              "tag": "always known"
            }
          },
          {
            "key": "note_accept_suggestion",
            "label": "Accept suggestion",
            "tool": "accept_suggestion",
            "when": {
              "tag": "suggestion"
            }
          },
          {
            "key": "note_still_true",
            "label": "Still true",
            "tool": "still_true",
            "when": {
              "tag": "may be out of date"
            }
          },
          {
            "key": "note_no_longer_true",
            "label": "No longer true",
            "tool": "no_longer_true",
            "unless": {
              "tag": "no longer true"
            }
          },
          {
            "key": "note_history",
            "label": "History",
            "tool": "history"
          },
          {
            "key": "note_forget",
            "label": "Forget",
            "tool": "forget_one",
            "confirm": "Forget it, and every earlier version of it?"
          }
        ]
      },
      {
        "key": "remembered_list",
        "type": "table",
        "label": "Remembered",
        "hint": "Everything Alexia has written down about you, whether you said it or it worked it out, and whether it is still true. What stopped being true is kept at the bottom as history; forgetting one takes every version of it.",
        "rows": "memories",
        "columns": [
          {
            "key": "text",
            "label": "What"
          },
          {
            "key": "from",
            "label": "How it got here"
          },
          {
            "key": "tags",
            "label": "State",
            "hideNarrow": true
          },
          {
            "key": "pinned",
            "label": "Always known",
            "hideNarrow": true
          },
          {
            "key": "when",
            "label": "Written down",
            "align": "right",
            "hideNarrow": true
          }
        ],
        "rowActions": [
          {
            "key": "still_true",
            "label": "Still true",
            "tool": "still_true",
            "when": {
              "tag": "may be out of date"
            }
          },
          {
            "key": "no_longer_true",
            "label": "No longer true",
            "tool": "no_longer_true",
            "unless": {
              "tag": "no longer true"
            }
          },
          {
            "key": "accept_suggestion",
            "label": "Accept suggestion",
            "tool": "accept_suggestion",
            "when": {
              "tag": "suggestion"
            }
          },
          {
            "key": "history",
            "label": "History",
            "tool": "history"
          },
          {
            "key": "pin",
            "label": "Always know this",
            "tool": "pin",
            "unless": {
              "field": "pinned",
              "is": "always known"
            }
          },
          {
            "key": "unpin",
            "label": "Stop always knowing",
            "tool": "unpin",
            "when": {
              "field": "pinned",
              "is": "always known"
            }
          },
          {
            "key": "forget_one",
            "label": "Forget",
            "tool": "forget_one",
            "confirm": "Forget it, and every earlier version of it?"
          }
        ],
        "detail": "about_memory",
        "filter": true,
        "groupBy": "kind",
        "chips": [
          {
            "key": "doubtful",
            "label": "May be out of date",
            "tags": [
              "may be out of date"
            ]
          },
          {
            "key": "suggested",
            "label": "Suggestions",
            "tags": [
              "suggestion"
            ]
          },
          {
            "key": "gone",
            "label": "No longer true",
            "tags": [
              "no longer true"
            ]
          }
        ]
      }
    ]
  },
  "lifetime": "resident"
}
