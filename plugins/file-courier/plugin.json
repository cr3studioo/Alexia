{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "file-courier",
  "name": "File courier",
  "summary": "Moves files between your computers, in pieces, checked at the end.",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 3,
  "mcp_protocol": "2025-11-25",
  "requires": [
    {
      "cap": "fs.read_scoped",
      "why": "To read only the files and folders you allow."
    },
    {
      "cap": "fs.write_scoped",
      "why": "To write only to the folders you allow."
    }
  ],
  "provides": [
    "file.stat",
    "file.read_chunk",
    "file.write_chunk"
  ]
}
