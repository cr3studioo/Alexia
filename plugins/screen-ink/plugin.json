{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "screen-ink",
  "name": "Screen ink",
  "summary": "Draws arrows, boxes and her own cursor on your screen to show you things.",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 3,
  "mcp_protocol": "2025-11-25",
  "requires": [
    {
      "cap": "proc.spawn",
      "why": "To run the helper programs this needs on your computer."
    }
  ],
  "provides": [
    "screen.draw",
    "screen.clear",
    "cursor.show"
  ]
}
