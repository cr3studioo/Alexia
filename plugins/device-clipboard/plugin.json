{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "device-clipboard",
  "name": "Clipboard",
  "summary": "Your clipboard on this computer, its history, and copying between your devices.",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 7,
  "mcp_protocol": "2025-11-25",
  "requires": [
    {
      "cap": "proc.spawn",
      "why": "To run the helper programs this needs on your computer."
    },
    {
      "cap": "fs.own_dir",
      "why": "To keep its own settings and data in its own folder."
    }
  ],
  "provides": [
    "clipboard.get",
    "clipboard.set",
    "clipboard.history"
  ],
  "settings": [
    {
      "type": "toggle",
      "key": "history",
      "label": "Keep a clipboard history",
      "default": true,
      "hint": "Remembers the last things you copied on this computer, as text only. Anything copied from a password manager is skipped. It never leaves this computer."
    },
    {
      "type": "choice",
      "key": "keep_days",
      "label": "Keep it for",
      "default": "7",
      "hint": "Older copies are deleted.",
      "options": [
        {
          "value": "1",
          "label": "1 day"
        },
        {
          "value": "7",
          "label": "7 days"
        },
        {
          "value": "30",
          "label": "30 days"
        }
      ]
    }
  ],
  "storage": {
    "namespace": "device-clipboard",
    "tables": [
      "clips"
    ]
  },
  "lifetime": "resident"
}
