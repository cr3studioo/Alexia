{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "hello",
  "name": "Hello",
  "summary": "Answers when spoken to. The plugin that proves the contract carries anything at all.",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 1,
  "mcp_protocol": "2025-11-25",
  "settings": [
    {
      "type": "text",
      "key": "greeting",
      "label": "Greeting",
      "hint": "What it says before your name.",
      "default": "Hello"
    }
  ],
  "storage": {
    "namespace": "hello",
    "tables": [
      "greetings"
    ]
  }
}
