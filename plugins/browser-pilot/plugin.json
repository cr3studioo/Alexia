{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "browser-pilot",
  "name": "Browser",
  "summary": "Reads and works in your own browser through Alexia's extension.",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 3,
  "mcp_protocol": "2025-11-25",
  "requires": [
    {
      "cap": "net.listen",
      "why": "To talk to Alexia’s browser extension on this computer only."
    },
    {
      "cap": "fs.own_dir",
      "why": "To keep its own settings and data in its own folder."
    }
  ],
  "provides": [
    "browser.tabs",
    "browser.read",
    "browser.click",
    "browser.fill",
    "browser.open"
  ]
}
