{
  "$schema": "../../docs/spec/plugin.schema.json",
  "manifest_version": 1,
  "id": "task-list",
  "name": "Tasks",
  "summary": "Your to-dos and reminders, by time, place or person.",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "entry": {
    "run": "node",
    "args": [
      "index.js"
    ]
  },
  "alexia_protocol": 3,
  "mcp_protocol": "2025-11-25",
  "requires": [
    {
      "cap": "context.current",
      "why": "To know when you arrive somewhere you named."
    },
    {
      "cap": "memory.recall",
      "why": "To know who a reminder is about."
    }
  ],
  "provides": [
    "tasks.add",
    "notice.items",
    "notice.done",
    "brief.section"
  ],
  "storage": {
    "namespace": "task-list",
    "tables": [
      "items"
    ]
  }
}
