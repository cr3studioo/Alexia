# Compose runtime. Backends must remain reachable only by the trusted TLS proxy.
COMPOSE_PROJECT_NAME=alexia-connect
CONNECT_BIND_ADDRESS=127.0.0.1
MAILBOX_HTTP_PORT=4000
RELAY_HTTP_PORT=3340
RELAY_METRICS_PORT=9090
MAILBOX_MEMORY_LIMIT=256m
MAILBOX_CPU_LIMIT=1.0
RELAY_MEMORY_LIMIT=512m
RELAY_CPU_LIMIT=2.0

# Mailbox 0.8.0 passes these to Autobahn with --websocket-protocol-option.
MAILBOX_MAX_CONNECTIONS=128
MAILBOX_MAX_FRAME_BYTES=65536
MAILBOX_MAX_MESSAGE_BYTES=65536
MAILBOX_HANDSHAKE_SECONDS=5
MAILBOX_PING_SECONDS=30
MAILBOX_PING_TIMEOUT_SECONDS=10
MAILBOX_BLUR_SECONDS=3600

# iroh-relay 1.3.0 [limits.client.rx]. Bytes/second and burst bytes per connection.
RELAY_RX_BYTES_PER_SECOND=10485760
RELAY_RX_BURST_BYTES=20971520
# Empty permits everyone. For a private relay: comma-separated 64-digit hex endpoint IDs.
# These are public identities, not pairing codes or private keys.
RELAY_ALLOWED_ENDPOINT_IDS=

# Operator-managed Nginx TLS proxy; render with render_proxy.py (not used by Compose).
MAILBOX_PUBLIC_HOST=mailbox.example.org
RELAY_PUBLIC_HOST=relay.example.org
MAILBOX_TLS_CERT_PATH=/etc/letsencrypt/live/mailbox.example.org/fullchain.pem
MAILBOX_TLS_KEY_PATH=/etc/letsencrypt/live/mailbox.example.org/privkey.pem
RELAY_TLS_CERT_PATH=/etc/letsencrypt/live/relay.example.org/fullchain.pem
RELAY_TLS_KEY_PATH=/etc/letsencrypt/live/relay.example.org/privkey.pem
MAILBOX_PROXY_REQUEST_RATE=10r/m
MAILBOX_PROXY_REQUEST_BURST=5
MAILBOX_PROXY_CONNECTIONS_PER_IP=8
MAILBOX_PROXY_CONNECTIONS_TOTAL=128
RELAY_PROXY_REQUEST_RATE=60r/m
RELAY_PROXY_REQUEST_BURST=20
RELAY_PROXY_CONNECTIONS_PER_IP=16
RELAY_PROXY_CONNECTIONS_TOTAL=1024
PROXY_IDLE_TIMEOUT_SECONDS=90
PROXY_METRICS_LOG_PATH=/var/log/nginx/alexia-connect-metrics.log
PROXY_STATUS_PORT=8081
