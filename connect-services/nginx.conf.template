# Full Nginx configuration for a proxy on the Docker host, rendered by render_proxy.py.
worker_processes auto;
error_log /dev/null;
events { worker_connections 4096; }

http {
    # Omit IPs, paths, queries, headers, endpoint IDs and bodies even on rejection.
    log_format connect_metrics '$server_name $status $request_time $bytes_sent $limit_req_status $limit_conn_status';
    access_log @@PROXY_METRICS_LOG_PATH@@ connect_metrics;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_header_timeout 10s;
    client_body_timeout 10s;
    client_max_body_size 1k;
    limit_req_status 429;
    limit_conn_status 429;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    limit_req_zone $binary_remote_addr zone=mailbox_requests:10m rate=@@MAILBOX_PROXY_REQUEST_RATE@@;
    limit_req_zone $binary_remote_addr zone=relay_requests:10m rate=@@RELAY_PROXY_REQUEST_RATE@@;
    limit_conn_zone $binary_remote_addr zone=mailbox_clients:10m;
    limit_conn_zone $binary_remote_addr zone=relay_clients:10m;
    limit_conn_zone $server_name zone=service_connections:10m;

    server {
        listen 127.0.0.1:@@PROXY_STATUS_PORT@@;
        server_name localhost;
        access_log off;
        location = /nginx_status {
            stub_status;
            allow 127.0.0.1;
            deny all;
        }
        location / { return 404; }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name @@MAILBOX_PUBLIC_HOST@@;
        ssl_certificate @@MAILBOX_TLS_CERT_PATH@@;
        ssl_certificate_key @@MAILBOX_TLS_KEY_PATH@@;
        limit_conn mailbox_clients @@MAILBOX_PROXY_CONNECTIONS_PER_IP@@;
        limit_conn service_connections @@MAILBOX_PROXY_CONNECTIONS_TOTAL@@;

        location = /v1 {
            limit_req zone=mailbox_requests burst=@@MAILBOX_PROXY_REQUEST_BURST@@ nodelay;
            proxy_pass http://@@CONNECT_UPSTREAM_ADDRESS@@:@@MAILBOX_HTTP_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Real-Port $remote_port;
            proxy_buffering off;
            proxy_read_timeout @@PROXY_IDLE_TIMEOUT_SECONDS@@s;
            proxy_send_timeout @@PROXY_IDLE_TIMEOUT_SECONDS@@s;
        }
        location = / {
            limit_req zone=mailbox_requests burst=@@MAILBOX_PROXY_REQUEST_BURST@@ nodelay;
            proxy_pass http://@@CONNECT_UPSTREAM_ADDRESS@@:@@MAILBOX_HTTP_PORT@@;
        }
        location / { return 404; }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name @@RELAY_PUBLIC_HOST@@;
        ssl_certificate @@RELAY_TLS_CERT_PATH@@;
        ssl_certificate_key @@RELAY_TLS_KEY_PATH@@;
        limit_conn relay_clients @@RELAY_PROXY_CONNECTIONS_PER_IP@@;
        limit_conn service_connections @@RELAY_PROXY_CONNECTIONS_TOTAL@@;
        limit_req zone=relay_requests burst=@@RELAY_PROXY_REQUEST_BURST@@ nodelay;

        location = /relay {
            proxy_pass http://@@CONNECT_UPSTREAM_ADDRESS@@:@@RELAY_HTTP_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_buffering off;
            proxy_read_timeout @@PROXY_IDLE_TIMEOUT_SECONDS@@s;
            proxy_send_timeout @@PROXY_IDLE_TIMEOUT_SECONDS@@s;
        }
        location = /healthz { proxy_pass http://@@CONNECT_UPSTREAM_ADDRESS@@:@@RELAY_HTTP_PORT@@; }
        location = /ping { proxy_pass http://@@CONNECT_UPSTREAM_ADDRESS@@:@@RELAY_HTTP_PORT@@; }
        location = /generate_204 { proxy_pass http://@@CONNECT_UPSTREAM_ADDRESS@@:@@RELAY_HTTP_PORT@@; }
        location / { return 404; }
    }

    server {
        listen 80;
        listen [::]:80;
        server_name @@MAILBOX_PUBLIC_HOST@@;
        return 308 https://@@MAILBOX_PUBLIC_HOST@@$request_uri;
    }
    server {
        listen 80;
        listen [::]:80;
        server_name @@RELAY_PUBLIC_HOST@@;
        location = /generate_204 {
            limit_req zone=relay_requests burst=@@RELAY_PROXY_REQUEST_BURST@@ nodelay;
            proxy_pass http://@@CONNECT_UPSTREAM_ADDRESS@@:@@RELAY_HTTP_PORT@@;
        }
        location / { return 308 https://@@RELAY_PUBLIC_HOST@@$request_uri; }
    }
}
